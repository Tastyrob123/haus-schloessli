"""Die Tafel (La Carte) · Berghotel Gasterntal — Anschluss an die Website (C11, C18, C20–C22, 17.10.2026).
Aufbau aus web.py der Tafel des Landgasthof Ruedihus (dort aus dem Doldenhorn), auf die Karte 2026 und den Bau des Gasterntal umgeschrieben.

Die Website zeigt die Karte 2026 als Zeilen: essen.html (Abschnitt id="karte", «Zettel-Tisch» mit Polaroids: jede Rubrik ein Zettel),
picknick.html (Rubrik «Öpis chalts», Abschnitt id="karte") und die Startseite (Rubriken «Grossis Küche» und «Gäng guet», Bildzeilen mit den
Preisen von Chäsefondue und Zvieri Plättli), dazu das Laufband mit Namen von Rubriken. Die Zeilen kommen aus daten.py SPEISEN und GETRAENKE
(Wortlaut des Hauses samt seiner Tippfehler, z. B. «Tagesssuppe», «Aperitiv»), über inhalt.py I.speisen() / I.getraenke(). Der Druck der Tafel
trägt die berichtigte Fassung (_werkbank/satz_daten.py BERICHTIGT). Diese Trennung bleibt; deshalb rechnet die Tafel die Zeilen nicht neu aus,
sondern führt sie nach:

  · Einmal beim Einlesen (abgleich()): jede Zeile der Website wird ihrem Eintrag der Tafel zugeordnet. Die Reihenfolge ist auf beiden Seiten die
    der Karte (Getränke auf Seite 1, Speisen auf Seite 2); jede Zuordnung wird an den Preisen geprüft. Jeder Eintrag, jede Rubrik und jeder
    Zwischentitel bekommt eine Kennung «id». Ablage _daten/web/abgleich.json mit dem Wortlaut beider Seiten zum Zeitpunkt des Einlesens.
  · Beim Veröffentlichen (zeilen_aus()): die Zeilen folgen der Reihenfolge der Tafel. Eine Zeile bleibt Wort für Wort im Wortlaut des Hauses,
    bis das Haus ihren Eintrag ändert; dann geht genau das geänderte Stück mit (Name, Zusatz, deutsche Zeile, englische Zeile, Preise).
    Ausgeblendet oder entfernt → die Zeile fällt weg. Ein neuer Eintrag kommt mit dem Wortlaut der Tafel an seine Stelle. Eine neue Rubrik
    bekommt eine neue Kennung; die bekannten behalten ihre (die Startseite und das Picknick suchen ihre Rubriken über die Kennung).
  · Mit Anschluss (Einstellung, nur Direktion): die Zeilen gehen nach _daten/web/karte.json. Die Seiten setzt der Bau des Hauses (bau.py,
    Ausgabe in Wegwerf-Ordner über BG_ZIEL, wie Der Schreibtisch es für seinen Entwurf tut), und zwar zweimal: mit den bisher veröffentlichten
    Zeilen und mit den neuen. Übernommen werden genau die Seiten, die sich zwischen diesen beiden Bauten unterscheiden, und nur, wenn die Seite
    im Projekt heute Byte für Byte dem ersten Bau gleicht. Weicht eine Seite ab, wird nur ihr Abschnitt id="karte" übernommen (essen.html,
    picknick.html) oder sie wird mit Namen gemeldet, nichts überschrieben. Danach Nachprüfung Byte für Byte. Damit der Bau die Zeilen liest,
    braucht inhalt.py karte_roh() einen Block (Patch in anschluss/, einsetzen macht der Werkbank-Chat). Ohne Patch meldet die Tafel
    «Seiten: Anschluss im Bau fehlt», die PDF geht trotzdem.
"""
import datetime, html, importlib.util, json, os, re, shutil, subprocess, sys, tempfile

HIER = os.path.dirname(os.path.abspath(__file__))
_WURZEL = os.path.dirname(os.path.dirname(HIER))
PROJ = os.environ.get('CARTE_PROJ') or (_WURZEL if os.path.isfile(os.path.join(_WURZEL, 'bau.py')) else os.path.join(_WURZEL, 'website'))   # Schlössli: Website in website/
DATEN = os.environ.get('CARTE_DATEN') or os.path.join(HIER, '_daten')
KARTEN = {'karte-2026': dict(vorsatz='k')}
ABSCHNITT = re.compile(r'<section\b[^>]*\bid="karte"[^>]*>')
REIHE = {'po': 'speisen', 're': 'getraenke'}


def _web_ordner():
    return os.environ.get('BG_CARTE_WEB') or os.path.join(DATEN, 'web')


# ---------------------------------------------------------------- für den Bau des Hauses (inhalt.py karte_roh(), Patch)
def zeilen(reihe, alt=None):
    """Rubriken einer Reihe (speisen · getraenke) im Format von inhalt.py KARTE_STANDARD: die von der Tafel veröffentlichten, sonst alt"""
    try:
        with open(os.path.join(_web_ordner(), 'karte.json'), encoding='utf-8') as f:
            d = json.load(f)
        r = d[reihe]
        return r if isinstance(r, list) else alt
    except (OSError, ValueError, KeyError, TypeError):
        return alt


# ---------------------------------------------------------------- die Website heute (Wortlaut des Hauses), genau wie inhalt.py _std_karte()
def slug(s):
    s = str(s or '').lower()
    for a, b in (('ä', 'ae'), ('ö', 'oe'), ('ü', 'ue'), ('ß', 'ss'), ('é', 'e'), ('è', 'e'), ('à', 'a')):
        s = s.replace(a, b)
    return re.sub(r'[^a-z0-9]+', '-', s).strip('-')[:40] or 'rubrik'


def _daten_modul():
    """daten.py des Projekts nur lesen (nach Pfad, nicht über sys.path: Falle F10, gleichnamige Module)"""
    spec = importlib.util.spec_from_file_location('bg_daten_tafel', os.path.join(PROJ, 'daten.py'))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def website_standard(D=None):
    """Die Zeilen, die die Website ohne Studio zeigt (inhalt.py _std_karte(), Zeile für Zeile gleich gebaut)"""
    D = D or _daten_modul()
    sp = [{'id': slug(t), 't': t, 'zus': zus, 'l': [{'n': n, 'z': z, 'en': en, 'pr': [[a, p] for a, p in preise]} for n, z, en, preise in gerichte]} for t, zus, gerichte in D.SPEISEN]
    gt = []
    for t, kopf, zz in D.GETRAENKE:
        l = []
        for n, zus, w in zz:
            l.append({'n': n, 'zw': True} if w is None else {'n': n, 'zus': zus or '', 'w': list(w)})
        gt.append({'id': slug(t), 't': t, 'kopf': list(kopf), 'l': l})
    return {'speisen': sp, 'getraenke': gt}


# ---------------------------------------------------------------- die Karte der Tafel (Baum aus dem Satz)
def _kl(n):
    m = re.search(r'\sclass="([^"]*)"', n['a'][1] or '')
    return m.group(1).split() if m else []


def _el(x):
    return isinstance(x, dict) and x.get('fn') == 'el'


def _text(x, ohne=()):
    """Text eines Teilbaums; Elemente mit einer Klasse oder einem Tag aus «ohne» zählen nicht"""
    if isinstance(x, str):
        return x
    if _el(x):
        if x['a'][0] in ohne or set(_kl(x)) & set(ohne) or x.get('aus'):
            return ''
        return ''.join(_text(y, ohne) for y in x['a'][2:])
    return ''


def _sauber(t):
    return re.sub(r'\s+', ' ', t).strip()


def _kind(x, tag=None, kl=None):
    for y in x['a'][2:]:
        if _el(y) and (tag is None or y['a'][0] == tag) and (kl is None or kl in _kl(y)):
            return y
    return None


def _kinder(x, tag=None, kl=None):
    return [y for y in x['a'][2:] if _el(y) and (tag is None or y['a'][0] == tag) and (kl is None or kl in _kl(y))]


def folge(d):
    """Alles, was die Website aus der Karte zeigt, in Lesereihenfolge: [(art, knoten, unsichtbar)] mit art rubrik · zw · re · po · ab
    (Absatz der Rubrik, z. B. die Zeile unter «Teigchüssi,»)"""
    aus = []

    def geh(x, unsichtbar):
        if not isinstance(x, dict) or x.get('fn') not in ('el', 'seite'):
            return
        u = unsichtbar or bool(x.get('aus'))
        if x['fn'] == 'el':
            kl = _kl(x)
            if 'rubrik' in kl:
                aus.append(('rubrik', x, u))
                return
            if 'zw' in kl and x['a'][0] == 'h3':
                aus.append(('zw', x, u))
                return
            if 're' in kl or 'po' in kl:
                aus.append(('re' if 're' in kl else 'po', x, u))
                return
            if x['a'][0] == 'p' and 'ab' in kl and 'klein' in kl:
                aus.append(('ab', x, u))
                return
            if 'deckel' in kl or 'ukasten' in kl or x['a'][0] == 'header':
                return
        for y in (x['a'][1:] if x['fn'] == 'seite' else x['a'][2:]):
            geh(y, u)
    for s in d['seiten']:
        geh(s, bool(s.get('aus')))
    return aus


def angaben(art, n):
    """Die Stücke eines Teils der Karte, so wie die Website sie braucht"""
    if art == 'rubrik':
        sp = _kind(n, 'span')
        rk = [y for y in n['a'][2:] if _el(y) and 'rk' in _kl(y)]
        return dict(t=_sauber(_text(sp, ('small',))) if sp else '', small=_sauber(''.join(_text(y) for y in (_kinder(sp, 'small') if sp else []))),
                    kopf=[_sauber(_text(b)) for b in (_kinder(rk[0], 'b') if rk else [])])
    if art in ('zw', 'ab'):
        return dict(t=_sauber(_text(n)))
    if art == 're':
        nm, rk = _kind(n, 'span', 're__n'), _kind(n, 'span', 'rk')
        toks = []
        for b in (_kinder(rk, 'b') if rk else []):
            em = _kind(b, 'em')
            toks.append([bool(em), _sauber(_text(b))])
        return dict(n=_sauber(_text(nm, ('small',))) if nm else '', zus=_sauber(''.join(_text(y) for y in _kinder(nm, 'small'))) if nm else '', toks=toks)
    if art == 'po':
        t, p = _kind(n, 'div', 'po__t'), _kind(n, 'div', 'po__p')
        h4 = _kind(t, 'h4') if t else None
        desc = [_sauber(_text(y)) for y in (_kinder(t, 'p') if t else []) if 'fr' not in _kl(y) and not y.get('leer') and _sauber(_text(y))]
        en = [_sauber(_text(y)) for y in (_kinder(t, 'p') if t else []) if 'fr' in _kl(y) and not y.get('leer') and _sauber(_text(y))]
        pr = []
        for pz in (_kinder(p, 'span', 'pz') if p else []):
            em, b = _kind(pz, 'em'), _kind(pz, 'b')
            if b is not None and _sauber(_text(b)):
                pr.append([_sauber(_text(em)) if em else '', _sauber(_text(b))])
        return dict(n=_sauber(_text(h4, ('small',))) if h4 else '', small=_sauber(''.join(_text(y) for y in _kinder(h4, 'small'))) if h4 else '',
                    desc=' '.join(desc), en=' '.join(en), pr=pr)
    return {}


def ids(d, vorsatz='k'):
    """Jedes Stück bekommt einmal eine Kennung (beim Einlesen). Kopien im Werkzeug verlieren sie und gelten als neu."""
    zahl = {}
    for art, n, _ in folge(d):
        v = {'rubrik': 'r', 'zw': 'w', 'ab': 'a'}.get(art, vorsatz)
        zahl[v] = zahl.get(v, 0) + 1
        n['id'] = f'{v}{zahl[v]}'
    return d


# ---------------------------------------------------------------- Abgleich beim Einlesen
def _preise_web(row, reihe):
    """Preise einer Website-Zeile (nur Zahlen), zum Prüfen der Zuordnung"""
    if reihe == 'speisen':
        return [p for _, p in row.get('pr', []) if p]
    return re.findall(r'\d+\.\d\d', ' '.join(row.get('w', [])) + ' ' + (row.get('zus') or ''))


def _preise_karte(art, a):
    if art == 'po':
        return [p for _, p in a['pr']]
    return [t for em, t in a['toks'] if not em and re.fullmatch(r'\d+\.\d\d', t)] + re.findall(r'\d+\.\d\d', a['zus'])


def abgleich(karten, D=None):
    """Website-Zeilen ↔ Stücke der Tafel (einmal, beim Einlesen). Beide in der Reihenfolge der Karte; jede Zuordnung an den Preisen geprüft."""
    std = website_standard(D)
    aus = {}
    for z in KARTEN:
        f = folge(karten[z])
        # Rubriken der Tafel nach Reihe: die Art ihrer Einträge entscheidet
        rub, cur = [], None
        for art, n, _ in f:
            if art == 'rubrik':
                cur = dict(n=n, reihe=None, teile=[])
                rub.append(cur)
            elif cur is not None:
                if art in REIHE and not cur['reihe']:
                    cur['reihe'] = REIHE[art]
                cur['teile'].append((art, n))
        paare, fehler = [], []
        for reihe in ('getraenke', 'speisen'):
            tr = [r for r in rub if r['reihe'] == reihe]
            wr = std[reihe]
            if len(tr) != len(wr):
                fehler.append(f'{reihe}: {len(tr)} Rubriken in der Karte, {len(wr)} auf der Website')
            for ri, (t, w) in enumerate(zip(tr, wr)):
                a = angaben('rubrik', t['n'])
                ab = next((angaben('ab', n) for art, n in t['teile'] if art == 'ab'), None)
                paare.append(dict(id=t['n']['id'], art='rubrik', reihe=reihe, rubrik=ri, web=dict(w, l=None), karte=dict(a, ab=ab['t'] if ab else '', ab_id=next((n['id'] for art, n in t['teile'] if art == 'ab'), ''))))
                stuecke = [(art, n) for art, n in t['teile'] if art in ('zw', 're', 'po')]
                # zwei Zeiger: Einträge der Reihe nach (an den Preisen geprüft), Zwischentitel nach ihrem Wortlaut. Ein Zwischentitel nur in der
                # Karte («Rosé» unter «Weine offen») bleibt «nicht auf der Website»; eine Zeile nur auf der Website hängt an ihrem Vorgänger.
                j, vor = 0, t['n']['id']
                norm = lambda x: re.sub(r'[^a-z0-9äöüéè]+', '', x.lower())
                for art, n in stuecke:
                    a = angaben(art, n)
                    if art == 'zw':
                        if j < len(w['l']) and w['l'][j].get('zw') and norm(w['l'][j]['n']) == norm(a['t']):
                            paare.append(dict(id=n['id'], art=art, reihe=reihe, rubrik=ri, web=w['l'][j], karte=a))
                            j += 1
                        else:
                            paare.append(dict(id=n['id'], art=art, reihe=reihe, rubrik=ri, web=None, karte=a))
                        vor = n['id']
                        continue
                    while j < len(w['l']) and w['l'][j].get('zw'):
                        paare.append(dict(id='', art='nur-web', reihe=reihe, rubrik=ri, web=w['l'][j], nach=vor))
                        j += 1
                    if j >= len(w['l']):
                        fehler.append(f'{w["t"]}: «{a["n"]}» hat keine Zeile auf der Website')
                        paare.append(dict(id=n['id'], art=art, reihe=reihe, rubrik=ri, web=None, karte=a))
                        continue
                    row = w['l'][j]
                    if sorted(_preise_web(row, reihe)) != sorted(_preise_karte(art, a)):
                        fehler.append(f'{w["t"]} «{row["n"]}»: Preise {_preise_web(row, reihe)} ≠ Karte {_preise_karte(art, a)}')
                    paare.append(dict(id=n['id'], art=art, reihe=reihe, rubrik=ri, web=row, karte=a))
                    vor, j = n['id'], j + 1
                for row in w['l'][j:]:
                    paare.append(dict(id='', art='nur-web', reihe=reihe, rubrik=ri, web=row, nach=vor))
        aus[z] = dict(paare=paare, fehler=fehler, rubriken={reihe: [dict(r, l=None) for r in std[reihe]] for reihe in std})
    return aus


# ---------------------------------------------------------------- Zeilen aus dem Stand der Tafel
def _ersetze(felder, alt, neu):
    """alt → neu im ersten Feld, das alt genau ist, sonst im ersten, das alt enthält. Gibt zurück, ob ersetzt wurde."""
    for i, v in enumerate(felder):
        if v == alt:
            felder[i] = neu
            return True
    for i, v in enumerate(felder):
        if alt and alt in v:
            felder[i] = v.replace(alt, neu, 1)
            return True
    return False


def _zusammen(toks, getrennt_masse=True):
    """Preisspalten eines Getränks für die Website: Angabe und folgender Preis als ein Wert («Cüpli 10.00»), Mass vorn (33cl) allein"""
    aus, i = [], 0
    while i < len(toks):
        em, t = toks[i]
        if em and i + 1 < len(toks) and not toks[i + 1][0] and not (i == 0 and getrennt_masse and re.fullmatch(r'\d+(cl|dl)', t)):
            aus.append(f'{t} {toks[i + 1][1]}')
            i += 2
            continue
        aus.append(t)
        i += 1
    return aus


def _row_re(row, a0, a1):
    r = json.loads(json.dumps(row))
    if a1['n'] != a0['n']:
        r['n'] = a1['n']
    if a1['zus'] != a0['zus']:
        if not a0['zus'] or r.get('zus', '') == a0['zus']:
            r['zus'] = a1['zus']
        else:
            f = [r.get('zus', '')]
            r['zus'] = f[0] if _ersetze(f, a0['zus'], a1['zus']) else a1['zus']
    if a1['toks'] != a0['toks']:
        felder, ok = list(r.get('w', [])) + [r.get('zus', '')], len(a1['toks']) == len(a0['toks'])
        if ok:
            for (e0, t0), (e1, t1) in zip(a0['toks'], a1['toks']):
                if t0 != t1 and not _ersetze(felder, t0, t1):
                    ok = False
                    break
        if ok:
            r['w'], r['zus'] = felder[:-1], felder[-1]
        else:
            r['w'] = _zusammen(a1['toks'])
    return r


def _row_po(row, a0, a1):
    r = json.loads(json.dumps(row))
    if a1['n'] != a0['n'] or a1['small'] != a0['small']:
        neu = a1['n'] + (' ' + a1['small'] if a1['small'] else '')
        if r['n'] == a0['n'] and a1['small'] == a0['small']:
            r['n'] = a1['n']
        elif a0['small'] and r['n'] == a0['n'] + ' ' + a0['small']:
            r['n'] = neu
        elif r.get('z') and _sauber(r['n'] + ' ' + r['z']) == a0['n']:
            r['n'], r['z'] = neu, ''
        else:
            r['n'] = neu
    if a1['desc'] != a0['desc']:
        r['z'] = a1['desc']
    if a1['en'] != a0['en']:
        r['en'] = a1['en']
    if a1['pr'] != a0['pr']:
        r['pr'] = [list(x) for x in a1['pr']]
    return r


def _row_neu(art, a):
    if art == 'po':
        return {'n': a['n'] + (' ' + a['small'] if a['small'] else ''), 'z': a['desc'], 'en': a['en'], 'pr': [list(x) for x in a['pr']]}
    if art == 're':
        return {'n': a['n'], 'zus': a['zus'], 'w': _zusammen(a['toks'])}
    return {'n': a['t'], 'zw': True}


def zeilen_aus(z, d, ab=None):
    """Website-Rubriken {speisen: [...], getraenke: [...]} aus dem Stand der Tafel, nach dem Abgleich vom Einlesen"""
    ab = ab or json.load(open(os.path.join(DATEN, 'web', 'abgleich.json'), encoding='utf-8'))[z]
    bek = {p['id']: p for p in ab['paare'] if p['id']}
    nach = {}
    for p in ab['paare']:
        if p['art'] == 'nur-web':
            nach.setdefault(p['nach'], []).append(p['web'])
    aus = {'speisen': [], 'getraenke': []}
    vergeben = {r['id'] for reihe in ab['rubriken'].values() for r in reihe}
    cur, teile = None, []

    def schliessen():
        if cur is None:
            return
        art0 = next((a for a, _, _ in teile if a in REIHE), None)
        reihe = REIHE.get(art0) or (cur['p']['reihe'] if cur['p'] else None)
        if not reihe:
            return
        rid = cur['n'].get('id')
        p = cur['p']
        a1 = angaben('rubrik', cur['n'])
        ab_n = next((n for a, n, u in teile if a == 'ab' and not u), None)
        ab_t = angaben('ab', ab_n)['t'] if ab_n is not None else ''
        if p:
            w = json.loads(json.dumps(p['web']))
            w.pop('l', None)
            k0 = p['karte']
            if a1['t'] != k0['t']:
                w['t'] = a1['t']
            if reihe == 'speisen':
                z0 = k0['small'] or k0.get('ab', '')
                z1 = a1['small'] or ab_t
                if z1 != z0:
                    w['zus'] = z1
            elif a1['kopf'] != k0['kopf']:
                w['kopf'] = a1['kopf']
        else:
            sid, i = slug(a1['t']), 2
            while sid in vergeben:
                sid, i = f'{slug(a1["t"])}-{i}', i + 1
            vergeben.add(sid)
            w = {'id': sid, 't': a1['t']}
            if reihe == 'speisen':
                w['zus'] = a1['small'] or ab_t
            else:
                w['kopf'] = a1['kopf']
        if cur['u']:
            w['aus'] = True
        l = [json.loads(json.dumps(x)) for x in nach.get(rid, [])] if rid else []
        for art, n, u in teile:
            if art not in ('zw', 're', 'po') or u:
                continue
            a1 = angaben(art, n)
            q = bek.get(n.get('id'))
            if q and q['art'] == art and q['web'] is None:
                if art == 'zw' and a1['t'] != q['karte']['t']:
                    l.append(_row_neu(art, a1))   # nur in der Karte, jetzt geändert: kommt auf die Website
                l.extend(json.loads(json.dumps(x)) for x in nach.get(n['id'], []))
                continue
            if q and q['art'] == art:
                if art == 're':
                    l.append(_row_re(q['web'], q['karte'], a1))
                elif art == 'po':
                    l.append(_row_po(q['web'], q['karte'], a1))
                else:
                    l.append({'n': q['web']['n'] if a1['t'] == q['karte']['t'] else a1['t'], 'zw': True})
            else:
                l.append(_row_neu(art, a1))
            l.extend(json.loads(json.dumps(x)) for x in nach.get(n.get('id'), []))
        w['l'] = l
        aus[reihe].append(w)

    for art, n, u in folge(d):
        if art == 'rubrik':
            schliessen()
            p = bek.get(n.get('id'))
            cur, teile = dict(n=n, u=u, p=p if p and p['art'] == 'rubrik' else None), []
        elif cur is not None:
            teile.append((art, n, u))
    schliessen()
    return aus


# ---------------------------------------------------------------- Seiten setzen (mit dem Bau des Hauses) und übernehmen
def _abschnitt(h):
    """(Anfang, Ende) des Abschnitts id="karte", verschachtelte <section> mitgezählt"""
    m = ABSCHNITT.search(h)
    if not m:
        return None
    i, tiefe = m.start(), 0
    for x in re.finditer(r'<(/?)section\b', h[i:]):
        tiefe += -1 if x.group(1) else 1
        if tiefe == 0:
            return i, i + x.start() + h[i + x.start():].index('>') + 1
    return None


def anschluss_im_bau():
    """Liest der Bau des Hauses die Zeilen der Tafel? (Patch in inhalt.py)"""
    try:
        return 'die_tafel_web' in open(os.path.join(PROJ, 'inhalt.py'), encoding='utf-8').read()
    except OSError:
        return False


def baue(webdir, ziel):
    """Alle Seiten mit den Zeilen in webdir in den Ordner ziel setzen (Bau des Hauses wie Der Schreibtisch: bau.py mit BG_ZIEL; liest den
    veröffentlichten Stand des Schreibtischs, schreibt nur in ziel)."""
    os.makedirs(ziel, exist_ok=True)
    env = dict(os.environ, BG_ZIEL=ziel, BG_CARTE_WEB=webdir, PYTHONDONTWRITEBYTECODE='1')
    for k in ('BG_MARKEN', 'BG_INHALT', 'BG_DATEN'):
        env.pop(k, None)
    r = subprocess.run([sys.executable, os.path.join(PROJ, 'bau.py')], cwd=PROJ, env=env, capture_output=True, text=True, timeout=240)
    if r.returncode:
        raise RuntimeError('Bau der Website: ' + (r.stderr or r.stdout)[-400:])
    return sorted(x for x in os.listdir(ziel) if x.endswith('.html'))


def _webdir(tmp, K, zz=None):
    """Ordner mit den Zeilen der Karte: wie veröffentlicht (zz None) oder die neuen"""
    w = os.path.join(tmp, 'web')
    os.makedirs(w, exist_ok=True)
    p = os.path.join(K, 'web', 'karte.json')
    if zz is not None:
        with open(os.path.join(w, 'karte.json'), 'w', encoding='utf-8') as f:
            json.dump(zz, f, ensure_ascii=False)
    elif os.path.exists(p):
        shutil.copy2(p, os.path.join(w, 'karte.json'))
    return w


def _lies(p):
    with open(p, encoding='utf-8') as f:
        return f.read()


def anschliessen(z, d, K=None):
    """Nach dem Veröffentlichen (mit Anschluss): Seiten mit den alten und den neuen Zeilen bauen, die Seiten übernehmen, die sich dadurch
    ändern, nachprüfen, erst dann die Zeilen als veröffentlicht ablegen. Gibt zurück, was übernommen ist (und was nicht, mit Grund)."""
    if z not in KARTEN:
        return []
    K = K or DATEN
    zz = zeilen_aus(z, d)
    if not anschluss_im_bau():
        _ablegen(K, zz)
        return ['Seiten: Anschluss im Bau fehlt']
    meldung = []
    with tempfile.TemporaryDirectory(prefix='tafel-bau-') as tmp:
        a_dir, b_dir = os.path.join(tmp, 'alt'), os.path.join(tmp, 'neu')
        alt_seiten = baue(_webdir(os.path.join(tmp, 'a'), K), a_dir)
        baue(_webdir(os.path.join(tmp, 'b'), K, zz), b_dir)
        betroffen = [s for s in alt_seiten if os.path.exists(os.path.join(b_dir, s)) and _lies(os.path.join(a_dir, s)) != _lies(os.path.join(b_dir, s))]
        zeit = datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
        for s in betroffen:
            ziel = os.path.join(PROJ, s)
            heute, a, b = _lies(ziel) if os.path.exists(ziel) else None, _lies(os.path.join(a_dir, s)), _lies(os.path.join(b_dir, s))
            if heute == a:
                neu = b
            elif heute and _abschnitt(heute) and _abschnitt(b) and _abschnitt(a) and heute[slice(*_abschnitt(heute))] == a[slice(*_abschnitt(a))]:
                x, y = _abschnitt(heute), _abschnitt(b)
                neu = heute[:x[0]] + b[y[0]:y[1]] + heute[x[1]:]
                meldung.append(f'{s} (nur die Karte, die Seite weicht vom Bau ab)')
            else:
                meldung.append(f'{s} nicht übernommen (weicht vom Bau ab, bitte neu bauen)')
                continue
            if neu == heute:
                continue
            sd = os.path.join(K, 'verlauf', z)
            os.makedirs(sd, exist_ok=True)
            if heute is not None:
                shutil.copy2(ziel, os.path.join(sd, f'seite-{s}-{zeit}'))
            with open(ziel + '.neu', 'w', encoding='utf-8') as f:
                f.write(neu)
            os.replace(ziel + '.neu', ziel)
            if _lies(ziel) != neu:   # nachprüfen
                raise RuntimeError(f'{s}: nach dem Schreiben nicht gleich')
            if not any(m.startswith(s) for m in meldung):
                meldung.append(s)
    _ablegen(K, zz)
    return meldung


def _ablegen(K, zz):
    os.makedirs(os.path.join(K, 'web'), exist_ok=True)
    p = os.path.join(K, 'web', 'karte.json')
    with open(p + '.neu', 'w', encoding='utf-8') as f:
        json.dump(zz, f, ensure_ascii=False, indent=1)
    os.replace(p + '.neu', p)


SEITEN = ('essen.html', 'picknick.html', 'index.html')


def seite_mit(z, d, seite, K=None):
    """Ansicht «Website» im Werkzeug: die Seite mit den Zeilen dieses Stands (oder Entwurfs). None, wenn der Bau die Tafel nicht liest."""
    if z not in KARTEN or not anschluss_im_bau() or seite not in SEITEN:
        return None
    K = K or DATEN
    with tempfile.TemporaryDirectory(prefix='tafel-sicht-') as tmp:
        baue(_webdir(os.path.join(tmp, 'w'), K, zeilen_aus(z, d)), os.path.join(tmp, 's'))
        return _lies(os.path.join(tmp, 's', seite))
